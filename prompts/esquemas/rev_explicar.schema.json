{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hallazgos"
  ],
  "properties": {
    "hallazgos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "regla",
          "linea",
          "descripcion",
          "explicacion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^H[1-9][0-9]*$"
          },
          "regla": {
            "enum": [
              "SEC-01",
              "SEC-02",
              "SEC-03",
              "SEC-04",
              "SEC-05",
              "SEC-06",
              "SEC-07",
              "SEC-08",
              "SEC-09",
              "SEC-10"
            ]
          },
          "linea": {
            "type": "integer",
            "minimum": 1
          },
          "descripcion": {
            "type": "string",
            "minLength": 1
          },
          "explicacion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
