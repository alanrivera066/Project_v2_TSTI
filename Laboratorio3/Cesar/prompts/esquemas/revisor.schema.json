{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hallazgos",
    "fuentes",
    "estado"
  ],
  "properties": {
    "estado": {
      "enum": [
        "hallazgos",
        "sin hallazgos"
      ]
    },
    "fuentes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(doc:)?sec-(0[1-9]|10)(#[0-9]+)?$"
      }
    },
    "hallazgos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "regla",
          "linea",
          "severidad",
          "explicacion",
          "parche"
        ],
        "properties": {
          "regla": {
            "type": "string",
            "pattern": "^SEC-(0[1-9]|10)$"
          },
          "linea": {
            "type": "integer",
            "minimum": 1
          },
          "severidad": {
            "enum": [
              "critica",
              "alta",
              "media",
              "baja"
            ]
          },
          "explicacion": {
            "type": "string",
            "minLength": 10
          },
          "parche": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
